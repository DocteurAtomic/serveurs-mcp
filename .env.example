# Copied to .env by ./setup/install.sh, which fills the passwords with random values.
# .env is ignored by git: never commit it.

# SQL Server of the lab (setup only; the MCP server never connects as sa).
MSSQL_SA_PASSWORD=
# Accounts created by setup/accounts.sql.
PACHA_APP_PASSWORD=
MCP_READER_PASSWORD=

# What the MCP server reads at startup. A variable set in the real environment wins.
# 127.0.0.1 and not localhost: localhost resolves to ::1 first, and the port is only
# published on 127.0.0.1.
PACHA_SQL_SERVER=127.0.0.1,14733
PACHA_SQL_DATABASE=PachadataTraining
# Where the tools that write do it: the copy recreated by ./setup/reset-copy.sh m07.
PACHA_SQL_WRITE_DATABASE=PachadataTraining_m07
PACHA_SQL_USER=mcp_reader
PACHA_SQL_PASSWORD=

# Streamable HTTP: `uv run pachatraining-mcp --http` listens on 127.0.0.1 and on this port
# (8000 when unset).
# PACHA_HTTP_PORT=8000
# The key that seals a confirmation between its two rounds. Unset, each process draws its
# own: a retry that reaches another process, or the same one after a restart, is refused.
# Every process that serves the same clients gets the same value, drawn once with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
# PACHA_REQUEST_STATE_KEY=
# The names the team reaches the HTTP server by, separated by commas, accepted as Host and
# Origin on top of the names of this machine. Unset or empty: this machine only.
# PACHA_HTTP_HOSTS=mcp.pachadata.example
# The team tokens: name:token pairs separated by commas. Over HTTP, a request without one of
# these tokens in "Authorization: Bearer <token>" gets 401, and the server says on stderr which
# colleague each request comes from. Over stdio there is no token, and the tools that write
# refuse. `uv run python setup/new_token.py <name>` draws a token, adds it here and prints it
# once, for the colleague. `--http` does not start while this is empty.
PACHA_TOKENS=
